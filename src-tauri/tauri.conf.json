{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DnD Cards",
  "mainBinaryName": "dnd-cards-app",
  "identifier": "io.github.dnd-cards",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DnD Cards",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../data/": "data/" },
    "windows": { "nsis": { "installerHooks": "installer-hooks.nsh" } },
    "category": "Utility",
    "shortDescription": "Printable DnD 5.5e reference cards",
    "copyright": "Code: MIT. SRD texts: CC-BY 4.0."
  }
}
